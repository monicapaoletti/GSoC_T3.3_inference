# Settings read by container/run.sh and container/build_sif.sh.
IMAGE=gsoc-t33-claude
SCIENCE_IMAGE=gsoc-t33-science

# Where the repo is mounted inside the container. The memory mount in run.sh is derived
# from this, so changing it means changing that path too.
WORKDIR=/workspaces/GSoC_T3.3_inference

# JAX build for the cluster image (build_sif.sh). The laptop image defaults to CPU wheels.
CLUSTER_JAX_SPEC="jax[cuda12]==0.6.2"

# Where build_sif.sh drops the tarball to copy to a cluster.
OUT_DIR=$HOME/Desktop/GSoC/containers
